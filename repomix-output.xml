<file path="Backend/prisma/schema.prisma">
generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ROLES DEL SISTEMA
// ==========================================
enum Role {
  CLIENT
  ADMIN
  MECHANIC
}

// ==========================================
// USUARIOS Y AUTENTICACIÓN
// ==========================================
model User {
  id                   Int           @id @default(autoincrement())
  email                String        @unique
  password             String
  name                 String
  phone                String?       @unique
  vehicleModel         String?   
  role                 Role          @default(CLIENT)
  
  isEmailVerified      Boolean       @default(false)
  isPhoneVerified      Boolean       @default(false)
  verificationToken    String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Relación: Un usuario puede tener muchos turnos en su historial
  appointments         Appointment[]
}

// ==========================================
// TURNOS Y PAGOS
// ==========================================
model Appointment {
  id          Int       @id @default(autoincrement())
  
  // Relación con el Usuario registrado
  userId      Int?
  user        User?     @relation(fields: [userId], references: [id])
  
  clientName  String    // Lo mantenemos por si necesitan agendar a alguien manualmente en el local
  vehiclePlate String?
  date        DateTime
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  
  payment     Payment?
}

model Payment {
  id            Int         @id @default(autoincrement())
  amount        Decimal     @db.Decimal(10, 2)
  method        String
  createdAt     DateTime    @default(now())
  
  appointmentId Int         @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
}

// ==========================================
// CATÁLOGO DE PRODUCTOS
// ==========================================
model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  presentation String
  price        Decimal  @db.Decimal(10, 2)
  stock        Int      @default(0)
  imageUrl     String?
  categoryId   Int
  category     Category @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now())
}
</file>

