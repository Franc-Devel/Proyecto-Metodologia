/* ==========================================================================
   Paleta de Colores: Celeste Azulado / Morado
   ========================================================================== */
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap");

:root {
  --primary: #4f46e5; /* Morado principal */
  --primary-light: #6366f1; /* Morado claro / azulado */
  --accent: #0ea5e9; /* Celeste vibrante para contrastes */
  --dark-blue: #1e1b4b; /* Azul noche para footers/navbar */
  --gray-bg: #f8fafc;
}

body {
  font-family: "Inter", sans-serif;
  background-color: var(--gray-bg) !important;
}

/* Clases utilitarias de color personalizadas */
.custom-text-primary {
  color: var(--primary) !important;
}
.custom-text-accent {
  color: var(--accent) !important;
}
.custom-bg-primary {
  background-color: var(--primary) !important;
}
.custom-btn {
  background-color: var(--primary);
  color: white;
  transition: all 0.3s;
  border: none;
}
.custom-btn:hover {
  background-color: var(--primary-light);
  color: white;
  transform: scale(1.02);
}

/* --- Navbar --- */
.custom-navbar {
  background-color: var(--dark-blue) !important;
  border-bottom: 3px solid var(--accent);
}
.cursor-pointer {
  cursor: pointer;
  transition: color 0.2s;
}
.cursor-pointer:hover {
  color: var(--accent) !important;
}

/* --- Hero Banner --- */
.hero-banner {
  background:
    linear-gradient(135deg, rgba(30, 27, 75, 0.85), rgba(79, 70, 229, 0.85)),
    url("https://images.unsplash.com/photo-1619642751034-765dfdf7c58e?q=80&w=1920&auto=format&fit=crop")
      center/cover;
  height: 350px;
  border-bottom: 5px solid var(--accent);
}
.shadow-text {
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.6);
}

/* --- Títulos de Sección (Estilo Bardahl) --- */
.section-title {
  display: inline-block;
  padding-bottom: 10px;
  border-bottom: 2px solid #ccc;
  position: relative;
  font-size: 1.5rem;
  letter-spacing: 1px;
}
.section-title::after {
  content: "";
  position: absolute;
  bottom: -2px;
  left: 25%;
  width: 50%;
  height: 2px;
  background-color: var(--primary);
}

/* --- Rubros (Iconos) --- */
.rubro-item {
  cursor: pointer;
  transition: transform 0.3s ease;
}
.rubro-item:hover {
  transform: translateY(-5px);
}
.rubro-icon {
  font-size: 3.5rem;
  color: #a1a1aa;
  transition: color 0.3s ease;
}
.rubro-item:hover .rubro-icon {
  color: var(--primary);
}

/* --- Tarjetas de Producto --- */
.product-card {
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  overflow: hidden;
  transition:
    box-shadow 0.3s,
    transform 0.3s;
}
.product-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 25px rgba(79, 70, 229, 0.15) !important;
}
.product-image-container {
  height: 220px;
  background-color: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* --- Info Section --- */
.info-section {
  background: linear-gradient(to right, var(--dark-blue), var(--primary));
}
/* ========================================== */
/* ESTILOS PARA EL CARRUSEL                   */
/* ========================================== */

/* Limita el alto máximo del carrusel para que no ocupe toda la pantalla */
.custom-carousel {
    max-height: 400px;
    background-color: #1a1a1a; /* Fondo oscuro por si la imagen tarda en cargar */
}

/* Fuerza a que las imágenes se adapten correctamente al contenedor sin deformarse */
.carousel-img {
    height: 400px;
    object-fit: cover; /* Recorta la imagen proporcionalmente para rellenar el espacio */
    object-position: center;
}

/* Mejora la lectura del texto arriba de las fotos */
.custom-caption {
    background: rgba(0, 0, 0, 0.6); /* Capa negra semitransparente */
    border-radius: 10px;
    padding: 15px 20px;
    bottom: 30px;
}

/* Efecto responsive: achica un poco el alto en celulares */
@media (max-width: 768px) {
    .custom-carousel,
    .carousel-img {
        height: 250px;
    }
}
